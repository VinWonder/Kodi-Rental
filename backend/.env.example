# Copy to backend/.env and fill in. Never commit the real .env.

KODI_ENV=development
KODI_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/kodi

# python -c "import secrets; print(secrets.token_urlsafe(48))"
KODI_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KODI_FERNET_KEY=change-me

# Public HTTPS origin Safaricom can reach (use ngrok / cloudflared in development).
KODI_PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
KODI_FRONTEND_BASE_URL=http://localhost:5500
KODI_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

KODI_MEDIA_ROOT=./media
KODI_MAX_UPLOAD_MB=25

# Production: set to Safaricom's published callback IPs (check the current list in
# the Daraja docs) and KODI_TRUST_PROXY_HEADERS=true only behind your own proxy.
KODI_MPESA_CALLBACK_IP_ALLOWLIST=[]
KODI_TRUST_PROXY_HEADERS=false
KODI_MPESA_C2B_REJECT_UNKNOWN_REF=false
KODI_STK_TIMEOUT_SECONDS=180

KODI_SCHEDULER_ENABLED=true
KODI_BILLING_HOUR_EAT=6

# WebRTC. A TURN server (e.g. coturn with use-auth-secret) is strongly
# recommended: many Kenyan mobile networks sit behind carrier-grade NAT.
KODI_STUN_URLS=["stun:stun.l.google.com:19302"]
KODI_TURN_URLS=[]
KODI_TURN_SECRET=
KODI_CALL_RING_TIMEOUT_SECONDS=45

# Web Push (installed-app notifications). Generate a pair with:
#   .venv\Scripts\python -m app.tools.gen_vapid
KODI_VAPID_PUBLIC_KEY=
KODI_VAPID_PRIVATE_KEY=
# A contact push services can reach if something goes wrong (mailto: or https:).
KODI_VAPID_SUBJECT=mailto:support@example.com

# Serve the PWA from ../frontend on the same origin as the API.
KODI_SERVE_FRONTEND=true

# Tests create/drop a database called kodi_test on this server.
KODI_TEST_ADMIN_DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
